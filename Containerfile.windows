# Cross-build container for the Windows FFmpeg

FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        automake \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        g++-mingw-w64-x86-64 \
        gcc-mingw-w64-x86-64 \
        git \
        libtool \
        meson \
        nasm \
        ninja-build \
        patch \
        pkg-config \
        xz-utils \
        yasm \
        zip \
        zstd \
    && rm -rf /var/lib/apt/lists/*
